{
  "alwaysThinkingEnabled": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write(src/**/*.ts)",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write \"${CLAUDE_FILE}\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Write(src/**/*.tsx)",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write \"${CLAUDE_FILE}\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read(.env*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Blocked: Sensitive file access not allowed' && exit 2"
          }
        ]
      },
      {
        "matcher": "Read(secrets/**)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Blocked: Secrets directory is protected' && exit 2"
          }
        ]
      },
      {
        "matcher": "Write(.env*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Blocked: Cannot modify environment files' && exit 2"
          }
        ]
      }
    ]
  },
  "aicgen": {
    "profileLevel": "full",
    "safety": [
      "Generated hooks are limited to local deterministic checks.",
      "Generated hooks do not run test suites; use /check for validation.",
      "Review hook commands before enabling additional side-effecting automation.",
      "MCP and plugin setup scripts are not generated without explicit opt-in."
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(git:*)",
      "Bash(npx:*)",
      "Read(src/**)",
      "Read(package.json)",
      "Read(tsconfig.json)",
      "Read(CLAUDE.md)",
      "Read(.claude/**)",
      "Write(src/**)",
      "Write(.claude/**)",
      "WebSearch"
    ],
    "deny": [
      "Read(.env*)",
      "Read(secrets/**)",
      "Bash(rm:*)",
      "Bash(sudo:*)"
    ],
    "ask": [
      "Write(package.json)",
      "Write(.gitignore)",
      "Write(.env.example)"
    ]
  },
  "sandbox": {
    "allowInternetAccess": true,
    "workingDirectory": "F:\\aicgen\\aicgen-site"
  }
}
